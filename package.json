{
  "name": "windscribe-ips",
  "version": "2.0.0",
  "description": "An automatically updated collection and scraper of IP addresses and subdomains associated with Windscribe VPN.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "windscribe-ips": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "scrape": "tsx src/index.ts",
    "scrape:server": "tsx src/index.ts --only-server",
    "scrape:entry": "tsx src/index.ts --only-entry",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhoisGray/Windscribe-IPs.git"
  },
  "keywords": [
    "windscribe",
    "vpn",
    "ip-blocklist",
    "vpn-ips",
    "threat-intelligence",
    "scraper",
    "entry-ips",
    "typescript"
  ],
  "author": "WhoisGray",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/WhoisGray/Windscribe-IPs/issues"
  },
  "homepage": "https://github.com/WhoisGray/Windscribe-IPs#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
